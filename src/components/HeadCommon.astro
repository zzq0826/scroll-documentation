---
import "../styles/theme.css"
import "../styles/index.css"
import "../styles/migrated.css"
import "../styles/prism-darcula.css"

import "../styles/design-system/global-styles.css"
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />

<!-- <link href="/assets/icons/favicon-32x32.png" rel="shortcut icon" type="image/x-icon" /> -->
<link rel="icon" type="image/x-icon" href="/assets/icons/favicon.ico" />
<link href="/assets/icons/apple-touch-icon-256x256.png" rel="apple-touch-icon" />

<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Scrollable a11y code helper -->
<script src="/make-scrollable-code-focusable.js" is:inline></script>

<!-- Ensure i18next is initialized before client components load -->
<script is:inline>
  // Initialize i18next early to ensure translations are ready for client components
  ;(function () {
    if (typeof window === "undefined") return

    // Get language from HTML lang attribute or URL path
    const getLanguage = () => {
      const htmlLang = document.documentElement.lang
      if (htmlLang) {
        // Extract language code (e.g., "en-us" -> "en")
        return htmlLang.split("-")[0]
      }
      const pathLang = window.location.pathname.split("/")[1]
      if (["en", "es", "zh", "tr"].includes(pathLang)) {
        return pathLang
      }
      return "en"
    }

    // Wait for i18next to be available and initialize
    const initI18next = () => {
      if (window.i18next) {
        const lang = getLanguage()
        // Ensure language is set and wait for initialization
        if (window.i18next.language !== lang) {
          window.i18next.changeLanguage(lang)
        }
        // Mark i18next as ready
        window.__i18nextReady = true
        window.dispatchEvent(new CustomEvent("i18next:ready"))
      } else {
        // Retry if i18next is not loaded yet
        setTimeout(initI18next, 10)
      }
    }

    // Start initialization when DOM is ready
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initI18next)
    } else {
      initI18next()
    }
  })()
</script>

<!-- Mermaid.js for client-side rendering -->
<script type="module">
  import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs"
  mermaid.initialize({ startOnLoad: true, theme: "default" })
</script>

